# Expensya Tunisia - Environment Configuration Example
# Copy this file to .env and configure your values

# Application
APP_NAME="Expensya Tunisia"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=expensya_tunisia
DB_USERNAME=expensya
DB_PASSWORD=expensya_secure_2025

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=expensya_redis_2025
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@expensya.tn"
MAIL_FROM_NAME="${APP_NAME}"

# OCR Services
GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_api_key_here
TESSERACT_PATH=/usr/bin/tesseract

# BCT (Banque Centrale de Tunisie) Exchange Rates API
BCT_API_URL=https://api.bct.gov.tn/

# Storage (S3 Compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Frontend
VITE_API_URL=http://localhost:8000/api
