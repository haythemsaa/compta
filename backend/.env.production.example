# ============================================================================
# Compteo TN - Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your production values
# IMPORTANT: Never commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME="Compteo TN"
APP_ENV=production
APP_KEY=  # Generate with: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE="Africa/Tunis"
APP_URL=https://compteo.tn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Performance
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=compteo_tunisia
DB_USERNAME=compteo
DB_PASSWORD=  # CHANGE THIS IN PRODUCTION!
DB_SSLMODE=prefer
DB_SCHEMA=public

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=  # CHANGE THIS IN PRODUCTION!
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=compteo_

# Redis Cluster (optional)
# REDIS_CLUSTER=true
# REDIS_CLUSTERS="tcp://10.0.1.1:7000,tcp://10.0.1.2:7000"

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=compteo_cache_
CACHE_TTL=3600

# Memcached (alternative to Redis)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=compteo.tn
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ----------------------------------------------------------------------------
# Queue Configuration
# ----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Queue Workers
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_MAX_JOBS=1000
QUEUE_WORKER_MAX_TIME=3600

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=  # Optional: Slack webhook for error notifications

# Log Rotation
LOG_DAILY_DAYS=14

# ----------------------------------------------------------------------------
# Mail Configuration
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=  # Your SMTP username
MAIL_PASSWORD=  # Your SMTP password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@compteo.tn"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=

# Alternative: Mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# ----------------------------------------------------------------------------
# Broadcast Configuration
# ----------------------------------------------------------------------------
BROADCAST_CONNECTION=redis
BROADCAST_DRIVER=pusher

# Pusher (for real-time notifications)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

# ----------------------------------------------------------------------------
# Filesystem Configuration
# ----------------------------------------------------------------------------
FILESYSTEM_DISK=s3  # local, s3, or other

# Local Storage
FILESYSTEM_LOCAL_ROOT=storage/app

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=compteo-tn-storage
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# Alternative: DigitalOcean Spaces
# AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------
# Compteo TN Specific Settings
# ----------------------------------------------------------------------------

# Organization Settings
DEFAULT_CURRENCY=TND
DEFAULT_TVA_RATE=19.00
ALLOWED_CURRENCIES=TND,EUR,USD

# Expense Report Settings
EXPENSE_MAX_FILE_SIZE=10240  # KB (10MB)
EXPENSE_ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,gif,webp
EXPENSE_AUTO_APPROVE_THRESHOLD=0  # Auto-approve if amount below (0 = disabled)

# Mileage Settings (Tunisia 2025)
MILEAGE_RATE_3CV_ESSENCE=0.280
MILEAGE_RATE_4CV_ESSENCE=0.320
MILEAGE_RATE_5CV_ESSENCE=0.350
MILEAGE_RATE_6CV_ESSENCE=0.390
MILEAGE_RATE_7CV_ESSENCE=0.420
MILEAGE_RATE_4CV_DIESEL=0.300
MILEAGE_RATE_5CV_DIESEL=0.330
MILEAGE_RATE_6CV_DIESEL=0.365
MILEAGE_RATE_7CV_DIESEL=0.395
MILEAGE_RATE_8CV_DIESEL=0.425

# Notifications
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK=

# Reports & Exports
REPORT_PDF_LOGO_PATH=storage/app/logo.png
REPORT_EXPORT_TEMP_PATH=storage/app/exports
REPORT_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# CORS
CORS_ALLOWED_ORIGINS=https://compteo.tn,https://www.compteo.tn
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Password Rules
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# JWT Authentication (if using)
JWT_SECRET=  # Generate a random string
JWT_TTL=60  # Minutes
JWT_REFRESH_TTL=20160  # Minutes (2 weeks)

# Two-Factor Authentication
2FA_ENABLED=false
2FA_ISSUER="${APP_NAME}"

# ----------------------------------------------------------------------------
# Third-Party Integrations
# ----------------------------------------------------------------------------

# OCR Service (for receipt scanning)
OCR_SERVICE=tesseract  # tesseract, google-vision, aws-textract
OCR_ENABLED=true
GOOGLE_VISION_API_KEY=
AWS_TEXTRACT_ENABLED=false

# Accounting Software Integration
ACCOUNTING_EXPORT_ENABLED=true
ACCOUNTING_SOFTWARE=sage  # sage, odoo, custom

# Sage Integration
SAGE_API_URL=
SAGE_API_KEY=
SAGE_API_SECRET=

# Odoo Integration
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# ----------------------------------------------------------------------------
# Monitoring & Analytics
# ----------------------------------------------------------------------------

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# New Relic (APM)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME="${APP_NAME}"

# Google Analytics
GOOGLE_ANALYTICS_ID=

# ----------------------------------------------------------------------------
# Backup & Maintenance
# ----------------------------------------------------------------------------

# Automated Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3  # local, s3, ftp
BACKUP_S3_BUCKET=compteo-backups
BACKUP_NOTIFICATION_EMAIL=admin@compteo.tn

# Database Backups
DB_BACKUP_ENABLED=true
DB_BACKUP_COMPRESS=true
DB_BACKUP_ENCRYPT=false
DB_BACKUP_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Performance & Optimization
# ----------------------------------------------------------------------------

# OpCache (PHP Performance)
OPCACHE_ENABLED=true
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=20000

# Query Cache
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600

# View Cache
VIEW_COMPILED_PATH=storage/framework/views

# Asset Versioning
ASSET_URL=https://cdn.compteo.tn
MIX_ASSET_URL="${ASSET_URL}"

# ----------------------------------------------------------------------------
# Debugging & Development (Disable in Production!)
# ----------------------------------------------------------------------------

# Telescope (Laravel Debugging Tool)
TELESCOPE_ENABLED=false
TELESCOPE_DOMAIN=compteo.tn
TELESCOPE_PATH=telescope

# Debugbar
DEBUGBAR_ENABLED=false

# Query Logging
DB_LOG_QUERIES=false
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1000  # milliseconds

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

FEATURE_MULTI_CURRENCY=true
FEATURE_MILEAGE_EXPENSES=true
FEATURE_EXPENSE_SPLITTING=false
FEATURE_MOBILE_APP=false
FEATURE_API_V2=false
FEATURE_AUDIT_LOGS=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_EXPORT_EXCEL=true
FEATURE_EXPORT_PDF=true

# ----------------------------------------------------------------------------
# API Keys & Secrets
# ----------------------------------------------------------------------------

# Generate with: php artisan key:generate
ENCRYPTION_KEY=

# Sanctum (API Authentication)
SANCTUM_STATEFUL_DOMAINS=compteo.tn,www.compteo.tn
SANCTUM_GUARD=web

# ----------------------------------------------------------------------------
# Vite (Frontend Build)
# ----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
